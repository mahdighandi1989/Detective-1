# ============================================================
# Detective-1 — Backend Environment Variables (example)
# Copy this file to `.env` and fill in real values.
# ============================================================

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
APP_NAME=Detective-1
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host/port for uvicorn
HOST=0.0.0.0
PORT=8000
# Default timezone
TIMEZONE=UTC
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# Security / Auth (JWT + RBAC)
# ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Password hashing
PWD_HASH_SCHEME=bcrypt
# First superuser created on startup (bootstrap)
FIRST_SUPERUSER_EMAIL=admin@detective-1.local
FIRST_SUPERUSER_PASSWORD=change-me-strong-password
# Default classification clearance for new users
DEFAULT_CLEARANCE_LEVEL=public

# ----------------------------------------------------------------
# PostgreSQL (relational data) — SQLAlchemy + Alembic
# ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=detective
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=detective1
# Full async SQLAlchemy URL (overrides individual settings if set)
DATABASE_URL=postgresql+asyncpg://detective:change-me-db-password@localhost:5432/detective1
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://detective:change-me-db-password@localhost:5432/detective1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ----------------------------------------------------------------
# Neo4j (graph database)
# ----------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_DATABASE=neo4j # Default database name in Neo4j (can be omitted if default)

# ----------------------------------------------------------------
# Redis (Celery broker/backend, caching)
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0 # Full Redis connection URL

# ----------------------------------------------------------------
# Celery (background task queue)
# ----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0 # Should point to your Redis instance
CELERY_RESULT_BACKEND=redis://localhost:6379/0 # Should point to your Redis instance

# ----------------------------------------------------------------
# Vector Database (for semantic search - choose pgvector or Qdrant)
# ----------------------------------------------------------------
# Options: pgvector, qdrant
VECTOR_DB_TYPE=pgvector

# --- Qdrant Configuration (if VECTOR_DB_TYPE=qdrant) ---
# QDRANT_HOST=localhost
# QDRANT_PORT=6333 # HTTP API port
# QDRANT_GRPC_PORT=6334 # gRPC API port
# QDRANT_API_KEY= # Optional, if Qdrant requires authentication
# QDRANT_COLLECTION_NAME=encyclopedia_articles

# --- pgvector Configuration (if VECTOR_DB_TYPE=pgvector) ---
# Uses the existing PostgreSQL connection settings (POSTGRES_HOST, POSTGRES_PORT, etc.)
# No additional variables are typically needed here beyond the main POSTGRES settings.

# ----------------------------------------------------------------
# LLM Integration (OpenAI, Perplexity, Gemini)
# ----------------------------------------------------------------
# Options: openai, perplexity, gemini
LLM_PROVIDER=openai

# --- OpenAI Configuration (if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-api-key # Get from platform.openai.com
LLM_OPENAI_MODEL_NAME=gpt-4o # e.g., gpt-4o, gpt-3.5-turbo, text-embedding-ada-002

# --- Perplexity Configuration (if LLM_PROVIDER=perplexity) ---
# PERPLEXITY_API_KEY=ppl_your-perplexity-api-key # Get from perplexity.ai
# LLM_PERPLEXITY_MODEL_NAME=sonar-large-online # e.g., sonar-small-online, sonar-large-online

# --- Google Gemini Configuration (if LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=AIza... # Get from makersuite.google.com or Google Cloud Console
# LLM_GEMINI_MODEL_NAME=gemini-pro # e.g., gemini-pro, gemini-1.5-flash

# --- Common LLM Settings ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# LLM_EMBEDDING_MODEL_NAME= # Specific model for embeddings if different from chat model (e.g., text-embedding-ada-002)

# ----------------------------------------------------------------
# File Storage (MinIO / AWS S3 compatible)
# ----------------------------------------------------------------
# Options: minio, s3
STORAGE_PROVIDER=minio

# --- MinIO Configuration (if STORAGE_PROVIDER=minio) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=detective1-files
MINIO_SECURE=false # Set to true for HTTPS (e.g., in production)

# --- AWS S3 Configuration (if STORAGE_PROVIDER=s3) ---
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1 # e.g., us-east-1, eu-west-1
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_ENDPOINT_URL= # Optional, for S3-compatible services (e.g., DigitalOcean Spaces, Ceph)